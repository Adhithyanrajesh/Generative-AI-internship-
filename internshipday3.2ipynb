    {
      "cell_type": "code",
      "source": [
        "daily_data['Fuel_Price_MinMax']=min_max_scaler.fit_transform(daily_data[['Fuel_Price']])\n",
        "\n",
        "daily_data['CPI_MinMax']=min_max_scaler.fit_transform(daily_data[['CPI']])\n",
        "\n",
