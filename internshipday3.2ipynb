    {
      "cell_type": "code",
      "source": [
        "\n",
        "from sklearn.preprocessing import MinMaxScaler,StandardScaler\n",
        "daily_data=pd.read_csv('/content/Walmart Data Analysis and Forcasting.csv')\n",
        "\n",
        "numerical_coloumns = ['Fuel_Price','CPI','Unemployment']\n",
        "daily_data.dropna(subset=numerical_coloumns,inplace=True)\n",
        "min_max_scaler=MinMaxScaler()\n",
        "standard_scaler=StandardScaler()\n",
        "\n",
        "daily_data['FuelPrice_Standard']=standard_scaler.fit_transform(daily_data[['Fuel_Price']])\n",
        "\n",
        "daily_data['CPI_standard']=standard_scaler.fit_transform(daily_data[['CPI']])\n",
        "\n",
        "daily_data['Unemployment_Standard']=standard_scaler.fit_transform(daily_data[['Unemployment']])\n",
        "\n",
        "print(daily_data[['FuelPrice_Standard','CPI_standard','Unemployment_Standard']])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
