        "sns.scatterplot(x=y_test, y=y_pred, color='blue', alpha=0.7)\n",
        "plt.xlabel(\"Actual Prices \")\n",
        "plt.ylabel(\"Predicted Prices\")\n",
        "plt.title(\"Actual Prices vs. Predicted Prices\")\n",
        "plt.axline([0,0],[1,1],color=\"red\",linestyle=\"--\")\n",
